# Runtime support for the Nix code generated by cc/emit.nix, passed to it as `R`.
# `loop`, `shlInt` and `sraInt` behave like the helpers of the same names in
# bench/spike/nix.nix. The floating-point helpers (rounding to single precision, the
# conversion to integers and the IEEE encodings in memory) are also used by cc/check.nix
# to fold constants and to write initial values.
let
  B = import ../lib/bits.nix;
  M = import ../lib/mem.nix;
  inherit (builtins)
    attrValues
    bitAnd
    div
    elemAt
    foldl'
    genList
    removeAttrs
    seq
    ;

  # `int << n` and `int >> n` (arithmetic, floor) for a variable shift amount n.
  shlInt = x: n: B.toSigned (B.shl (B.u32 x) n);
  sraInt = x: n: B.toSigned (B.sra (B.u32 x) n);

  # The same for `long long`, whose values are plain Nix integers (n < 63 for <<, n < 64
  # for >>). 2^63 is not a Nix integer, so >> 63 yields the sign directly.
  shlLL = x: n: x * B.pow2 n;
  sraLL =
    x: n:
    let
      p = B.pow2 n;
    in
    if n == 63 then (if x < 0 then -1 else 0) else div (x - bitAnd x (p - 1)) p;

  # Conversion to signed char: the low 8 bits, sign-extended.
  toS8 =
    x:
    let
      b = bitAnd x 255;
    in
    if b >= 128 then b - 256 else b;

  # Conversion to short: the low 16 bits, sign-extended.
  toS16 =
    x:
    let
      h = bitAnd x 65535;
    in
    if h >= 32768 then h - 65536 else h;

  # Signed 32-bit wrap of an int or long result: x modulo 2^32, in [-2^31, 2^31). The
  # generated code keeps |x| <= 2^62, so x + 2^31 does not overflow.
  wrapInt = x: bitAnd (x + 2147483648) 4294967295 - 2147483648;

  # The initial values of the data (`__data.init`): each [ address size value ] stores
  # value (unsigned form) in size bytes at address, in order.
  initData = foldl' (
    m: w:
    let
      a = elemAt w 0;
      size = elemAt w 1;
      v = elemAt w 2;
    in
    if size == 1 then
      M.storeByte m a v
    else if size == 2 then
      M.storeHalf m a v
    else
      M.storeWord m a v
  );

  # Loop driver, shaped like `run` in lib/cpu.nix. `vars` holds every variable the
  # loop carries (always including mem). Each iteration runs `body` while `cond`
  # holds; `body` may set `exit = true` to leave after the current iteration.
  # Iterations are folded 64 at a time, every carried variable is forced after each
  # chunk to keep thunk chains short, and the recursion is per chunk. The mem of every
  # iteration is forced as well: an inner loop leaves its memory as one thunk, and a
  # chain of them across the iterations of an outer loop would nest as deep as their
  # number when demanded.
  chunkLen = 64;
  forceMem = r: seq r.mem r;
  chunkTicks = genList (_: null) chunkLen;
  forceVars = v: foldl' (acc: x: seq x acc) v (attrValues v);
  runLoop =
    tick: vars:
    let
      go =
        v:
        let
          e = forceVars (foldl' tick v chunkTicks);
        in
        if e.exit then e else go e;
    in
    removeAttrs (go (vars // { exit = false; })) [ "exit" ];
  loop =
    cond: body:
    runLoop (
      v: _:
      if v.exit then
        v
      else if cond v then
        forceMem (body v)
      else
        v // { exit = true; }
    );

  # `loop` without a condition: each iteration runs `body` until it sets `exit = true`.
  loopDo = body: runLoop (v: _: if v.exit then v else forceMem (body v));

  # ---- Floating point ----
  # float and double values are Nix floats (IEEE double); a float value is always one that
  # IEEE single precision represents. Infinities and NaNs are never made on purpose: a
  # result that would be one throws (or fails in a later operation).

  # 2^k as a float, exactly, for -1074 <= k <= 1023: 2^i for 0 <= i <= 1023 is a power
  # below 2^62 times a power of 2^62, and 2^-i is 1 / 2^i (subnormal from 2^-1023 on,
  # reached by a second division).
  pow62 = genList (j: foldl' (a: _: a * 4611686018427387904.0) 1.0 (genList (x: x) j)) 17;
  posPow2 = genList (i: (B.pow2 (i - div i 62 * 62) + 0.0) * elemAt pow62 (div i 62)) 1024;
  negPow2 = genList (
    i:
    if i <= 1022 then 1.0 / elemAt posPow2 i else 1.0 / elemAt posPow2 1022 / elemAt posPow2 (i - 1022)
  ) 1075;
  pow2f = k: if k >= 0 then elemAt posPow2 k else elemAt negPow2 (0 - k);

  # floor (log2 x) for a float x > 0: the k in [-1074, 1023] with 2^k <= x < 2^(k + 1),
  # by bisection.
  ilog2 =
    x:
    let
      # mid = ceil ((lo + hi) / 2), with div applied to a non-negative number.
      go =
        lo: hi:
        let
          mid = div (lo + hi + 1 + 2148) 2 - 1074;
        in
        if lo == hi then
          lo
        else if pow2f mid <= x then
          go mid hi
        else
          go lo (mid - 1);
    in
    go (-1074) 1023;

  absF = x: if x < 0 then 0.0 - x else x;

  # The integer nearest to the float y >= 0 (below 2^62), ties to even.
  roundEven =
    y:
    let
      f = builtins.floor y;
      d = y - f;
    in
    if d > 0.5 then
      f + 1
    else if d < 0.5 then
      f
    else
      f + bitAnd f 1;

  maxF32 = 340282346638528859811704183484516925440.0;

  # The int, float or double x rounded to IEEE single precision (to nearest, ties to
  # even), without a range check: the result may lie beyond the largest float.
  roundF32 =
    x:
    let
      ax = absF (x + 0.0);
      e = ilog2 ax;
      # The exponent of the unit in the last place: 2^-149 for subnormals.
      q = if e < -126 then -149 else e - 23;
      u = pow2f q;
      r = (roundEven (ax / u) + 0.0) * u;
    in
    if ax == 0 then
      0.0
    else if x < 0 then
      0.0 - r
    else
      r;

  # Whether the float r (a value of roundF32) lies within the range of float.
  inF32 = r: !(absF r > maxF32);

  # The int, float or double x rounded to IEEE single precision (roundF32); a result
  # beyond the largest float throws.
  toF32 =
    x:
    let
      r = roundF32 x;
    in
    if inF32 r then r else throw "cc: floating-point overflow in a conversion to float";

  # Whether the float or double x truncates toward zero to an integer in [lo, hi] (the
  # range of an integer type).
  fInRange =
    lo: hi: x:
    !(x <= lo - 1.0 || x >= hi + 1.0);

  # The float or double x truncated toward zero, as an integer.
  truncF = x: if x < 0 then builtins.ceil x else builtins.floor x;

  # The float or double x truncated toward zero to an integer in [lo, hi] (the range of
  # the target type); a value outside it throws.
  fToInt =
    lo: hi: x:
    if fInRange lo hi x then
      truncF x
    else
      throw "cc: floating-point value out of the range of the integer type";

  # The bits (unsigned 32-bit) of the float x in IEEE single precision. -0.0 gives 0.
  f32Bits =
    x:
    let
      ax = absF x;
      e = ilog2 ax;
      s = if x < 0 then 2147483648 else 0;
    in
    if ax == 0 then
      0
    else if e < -126 then
      s + builtins.floor (ax / pow2f (-149))
    else
      s + (e + 127) * 8388608 + builtins.floor (ax / pow2f (e - 23)) - 8388608;

  # The float whose IEEE single precision bits are w (unsigned 32-bit).
  fromF32Bits =
    w:
    let
      ef = bitAnd (div w 8388608) 255;
      m = bitAnd w 8388607;
      v =
        if ef == 255 then
          throw "cc: floating-point infinity or NaN read from memory"
        else if ef == 0 then
          (m + 0.0) * pow2f (-149)
        else
          (m + 8388608 + 0.0) * pow2f (ef - 150);
    in
    if w >= 2147483648 then 0.0 - v else v;

  # The bits of the double x in IEEE double precision as two unsigned 32-bit words
  # { lo; hi; }. -0.0 gives 0.
  f64Words =
    x:
    let
      ax = absF x;
      e = ilog2 ax;
      s = if x < 0 then 2147483648 else 0;
      subnormal = e < -1022;
      # The significand without its leading 1 (below 2^52), and the biased exponent.
      m =
        if subnormal then
          builtins.floor (ax / pow2f (-1074))
        else
          builtins.floor (ax / pow2f (e - 52)) - 4503599627370496;
      ef = if subnormal then 0 else e + 1023;
    in
    if ax == 0 then
      {
        lo = 0;
        hi = 0;
      }
    else
      {
        lo = bitAnd m 4294967295;
        hi = s + ef * 1048576 + div m 4294967296;
      };

  # The double whose IEEE double precision bits are the words lo and hi.
  fromF64Words =
    lo: hi:
    let
      ef = bitAnd (div hi 1048576) 2047;
      m = bitAnd hi 1048575 * 4294967296 + lo;
      v =
        if ef == 2047 then
          throw "cc: floating-point infinity or NaN read from memory"
        else if ef == 0 then
          (m + 0.0) * pow2f (-1074)
        else
          (m + 4503599627370496 + 0.0) * pow2f (ef - 1075);
    in
    if hi >= 2147483648 then 0.0 - v else v;

  # Memory access of float (4 bytes) and double (8 bytes, the low word first) values.
  loadF32 = mem: a: fromF32Bits (M.loadWord mem a);
  loadF64 = mem: a: fromF64Words (M.loadWord mem a) (M.loadWord mem (B.add a 4));
  storeF64 =
    mem: a: x:
    let
      w = f64Words x;
    in
    M.storeWord (M.storeWord mem a w.lo) (B.add a 4) w.hi;
in
{
  inherit
    loop
    loopDo
    shlInt
    sraInt
    shlLL
    sraLL
    toS8
    toS16
    wrapInt
    initData
    pow2f
    roundF32
    inF32
    toF32
    fInRange
    truncF
    fToInt
    f32Bits
    fromF32Bits
    f64Words
    fromF64Words
    loadF32
    loadF64
    storeF64
    ;
}
