# Runtime support for the Nix code generated by cc/emit.nix, passed to it as `R`.
# `loop`, `shlInt` and `sraInt` behave like the helpers of the same names in
# bench/spike/nix.nix.
let
  B = import ../lib/bits.nix;
  M = import ../lib/mem.nix;
  inherit (builtins)
    attrValues
    bitAnd
    div
    elemAt
    foldl'
    genList
    removeAttrs
    seq
    ;

  # `int << n` and `int >> n` (arithmetic, floor) for a variable shift amount n.
  shlInt = x: n: B.toSigned (B.shl (B.u32 x) n);
  sraInt = x: n: B.toSigned (B.sra (B.u32 x) n);

  # The same for `long long`, whose values are plain Nix integers (n < 63 for <<, n < 64
  # for >>). 2^63 is not a Nix integer, so >> 63 yields the sign directly.
  shlLL = x: n: x * B.pow2 n;
  sraLL =
    x: n:
    let
      p = B.pow2 n;
    in
    if n == 63 then (if x < 0 then -1 else 0) else div (x - bitAnd x (p - 1)) p;

  # Conversion to signed char: the low 8 bits, sign-extended.
  toS8 =
    x:
    let
      b = bitAnd x 255;
    in
    if b >= 128 then b - 256 else b;

  # Conversion to short: the low 16 bits, sign-extended.
  toS16 =
    x:
    let
      h = bitAnd x 65535;
    in
    if h >= 32768 then h - 65536 else h;

  # Signed 32-bit wrap of an int or long result: x modulo 2^32, in [-2^31, 2^31). The
  # generated code keeps |x| <= 2^62, so x + 2^31 does not overflow.
  wrapInt = x: bitAnd (x + 2147483648) 4294967295 - 2147483648;

  # The initial values of the data (`__data.init`): each [ address size value ] stores
  # value (unsigned form) in size bytes at address, in order.
  initData = foldl' (
    m: w:
    let
      a = elemAt w 0;
      size = elemAt w 1;
      v = elemAt w 2;
    in
    if size == 1 then
      M.storeByte m a v
    else if size == 2 then
      M.storeHalf m a v
    else
      M.storeWord m a v
  );

  # Loop driver, shaped like `run` in lib/cpu.nix. `vars` holds every variable the
  # loop carries (always including mem). Each iteration runs `body` while `cond`
  # holds; `body` may set `exit = true` to leave after the current iteration.
  # Iterations are folded 64 at a time, every carried variable is forced after each
  # chunk to keep thunk chains short, and the recursion is per chunk.
  chunkLen = 64;
  chunkTicks = genList (_: null) chunkLen;
  forceVars = v: foldl' (acc: x: seq x acc) v (attrValues v);
  loop =
    cond: body: vars:
    let
      tick =
        v: _:
        if v.exit then
          v
        else if cond v then
          body v
        else
          v // { exit = true; };
      go =
        v:
        let
          e = forceVars (foldl' tick v chunkTicks);
        in
        if e.exit then e else go e;
    in
    removeAttrs (go (vars // { exit = false; })) [ "exit" ];
in
{
  inherit
    loop
    shlInt
    sraInt
    shlLL
    sraLL
    toS8
    toS16
    wrapInt
    initData
    ;
}
